{
  "info": {
    "_postman_id": "8c5d0d5a-7e17-4e9e-9d2d-api-testing-assignment4",
    "name": "Assignment 4 - JSONPlaceholder API Testing",
    "description": "Postman collection for functional API testing of JSONPlaceholder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    },
    {
      "key": "postId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "GET - All Posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "const data = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(data).to.be.an('array'); });",
              "pm.test('Posts contain required fields', function () {",
              "    pm.expect(data.length).to.be.greaterThan(0);",
              "    pm.expect(data[0]).to.have.property('id');",
              "    pm.expect(data[0]).to.have.property('title');",
              "    pm.expect(data[0]).to.have.property('body');",
              "    pm.expect(data[0]).to.have.property('userId');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Single Post",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "const data = pm.response.json();",
              "pm.test('Response has required fields', function () {",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data).to.have.property('title');",
              "    pm.expect(data).to.have.property('body');",
              "    pm.expect(data).to.have.property('userId');",
              "});",
              "pm.test('Post ID is 1', function () { pm.expect(data.id).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Create Post",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"API Testing Assignment\",\n  \"body\": \"Testing POST request with Postman\",\n  \"userId\": 1\n}"
        },
        "url": "{{baseUrl}}/posts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "const data = pm.response.json();",
              "pm.test('Response contains submitted fields', function () {",
              "    pm.expect(data.title).to.eql('API Testing Assignment');",
              "    pm.expect(data.body).to.eql('Testing POST request with Postman');",
              "    pm.expect(data.userId).to.eql(1);",
              "});",
              "pm.test('Response contains id', function () { pm.expect(data).to.have.property('id'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Update Post",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated API Testing Assignment\",\n  \"body\": \"Testing PUT request with Postman\",\n  \"userId\": 1\n}"
        },
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "const data = pm.response.json();",
              "pm.test('Post was updated', function () {",
              "    pm.expect(data.id).to.eql(1);",
              "    pm.expect(data.title).to.eql('Updated API Testing Assignment');",
              "    pm.expect(data.body).to.eql('Testing PUT request with Postman');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Delete Post",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });",
              "pm.test('Response is JSON object', function () { pm.expect(pm.response.json()).to.be.an('object'); });"
            ]
          }
        }
      ]
    }
  ]
}